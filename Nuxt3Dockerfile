# Base image
FROM node:25-alpine
ARG NUXT_PUBLIC_API_REMOTE_HOST=https://hvcao-api.sky-t.nl
ENV NUXT_PUBLIC_API_REMOTE_HOST=${NUXT_PUBLIC_API_REMOTE_HOST}

# Set working directory
WORKDIR /app

# Copy package.json and package-lock.json
COPY nuxt3/package*.json ./

# Install dependencies
RUN npm ci

# Copy source files
COPY nuxt3/ .

# Build the project for production
RUN npm run build

# Start the application in production mode
# CMD ["npx", "nuxt", "start"]
